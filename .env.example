# Jobs talk to Postgres directly (batch upserts + window functions over REST is a bad trade).
# Supabase → Project Settings → Database → Connection string → URI.
# Use the pooler (port 6543) for short-lived Actions jobs.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Dashboard only (Phase 4). Never expose the service key to the browser.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
DASHBOARD_PASSWORD=
