# Vercel → Project → Settings → Environment Variables.
# NONE of these may be prefixed NEXT_PUBLIC_ — that inlines them into the browser bundle.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role key, Supabase → Settings → API>
DASHBOARD_PASSWORD=<any strong string; the dashboard fails closed if unset>
